-- ==========================================
-- 🎲 ฟังก์ชันสร้างโจทย์คณิตศาสตร์
-- ==========================================
local function generateMathProblem()
	local operations = {"+", "-", "*"}
	local operation = operations[math.random(1, #operations)]
	
	local num1 = math.random(1, 20)
	local num2 = math.random(1, 20)
	local answer
	
	if operation == "+" then
		answer = num1 + num2
	elseif operation == "-" then
		-- ป้องกันเลขติดลบ
		if num1 < num2 then
			num1, num2 = num2, num1
		end
		answer = num1 - num2
	elseif operation == "*" then
		num1 = math.random(1, 10)
		num2 = math.random(1, 10)
		answer = num1 * num2
	end
	
	local question = num1 .. " " .. operation .. " " .. num2 .. " = ?"
	return question, answer
end

