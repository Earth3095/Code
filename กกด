			humanoid:MoveTo(targetRoot.Position)
			return
		end
		
		-- เดินตาม Waypoints
		local waypoints = path:GetWaypoints()
		
		for i, waypoint in ipairs(waypoints) do
			if currentState ~= AIStates.CHASE then
				break
			end
			
			humanoid:MoveTo(waypoint.Position)
			
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			
			-- รอให้ถึง Waypoint
			local timeout = humanoid.MoveToFinished:Wait()
		end
	end
	
	-- ==========================================
	-- 🔄 AI Loop (ทำงานตลอดเวลา)
	-- ==========================================
	spawn(function()
		while monster.Parent and humanoid.Health > 0 do
			-- หาผู้เล่นใกล้ที่สุด
			local nearestPlayer, distance = findNearestPlayer(rootPart.Position)
			
			if nearestPlayer then
				targetPlayer = nearestPlayer
				
				-- ตรวจสอบระยะ
				if distance <= GameConfig.Monster.AttackRange then
					-- โจมตี!
					currentState = AIStates.ATTACK
					humanoid:MoveTo(rootPart.Position) -- หยุดเดิน
					attackPlayer(targetPlayer)
					
				elseif distance <= GameConfig.Monster.DetectRange then
					-- ไล่ตาม!
					currentState = AIStates.CHASE
					chasePlayer(targetPlayer)
				else
					-- ไกลเกินไป กลับไป Idle
					currentState = AIStates.IDLE
					targetPlayer = nil
				end
			else
				-- ไม่มีผู้เล่นใกล้ๆ
				currentState = AIStates.IDLE
				targetPlayer = nil
			end
			
			-- รอก่อนเช็ครอบถัดไป
			wait(0.5)
		end
		
		-- ตาย
		currentState = AIStates.DEAD
		print("💀 [AI DEBUG]", monster.Name, "ตายแล้ว - หยุด AI")
	end)
	
	-- ==========================================
	-- 💀 เมื่อมอนสเตอร์ตาย
	-- ==========================================
	humanoid.Died:Connect(function()
		currentState = AIStates.DEAD
		
		print("💀 [AI DEBUG]", monster.Name, "ตาย!")
		
		-- ดรอปของ (ถ้าต้องการ)
		if _G.ItemDropSystem and not GameConfig.Quiz.Enabled then
			local dropPosition = rootPart.Position
			_G.ItemDropSystem.DropItem(dropPosition, monster.Name)
		end
		
		-- ให้เงินกับคนที่ฆ่า (ถ้าต้องการ)
		-- TODO: ระบุว่าใครฆ่า
		
		wait(2)
		monster:Destroy()
	end)
end

