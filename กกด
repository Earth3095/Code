local currentHP = 100
local maxHP = 100
local currentStamina = 100
local maxStamina = 100
local money = 0

local function updateHP(hp, max)
	currentHP = hp
	maxHP = max
	hpLabel.Text = "❤️ HP: " .. hp .. "/" .. max
	hpBar:TweenSize(UDim2.new(hp/max, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
	print("🔄 [DEBUG] อัปเดต HP:", hp, "/", max)
end

local function updateStamina(stamina, max)
	currentStamina = stamina
	maxStamina = max
	staminaLabel.Text = "⚡ Stamina: " .. stamina .. "/" .. max
	staminaBar:TweenSize(UDim2.new(stamina/max, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
	print("🔄 [DEBUG] อัปเดต Stamina:", stamina, "/", max)
end

local function updateMoney(amount)
	money = amount
	moneyLabel.Text = "💰 Money: " .. amount
	print("🔄 [DEBUG] อัปเดตเงิน:", amount)
end

