ShowMathQuiz.OnClientEvent:Connect(function(question, itemRef, difficulty)
	print("📩 [QUIZ DEBUG] ได้รับโจทย์:", question, "ความยาก:", difficulty or "Easy")
	
	if isQuizActive then
		warn("⚠️ [QUIZ DEBUG] มีโจทย์อยู่แล้ว!")
		return
	end
	
	isQuizActive = true
	currentItemReference = itemRef
	quizStartTime = tick()
	
	questionLabel.Text = question
	questionLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	answerBox.Text = ""
	hintLabel.Text = "💡 พิมพ์คำตอบแล้วกดส่ง"
	hintLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	
	backdrop.Visible = true
	frame.Visible = true
	answerBox:CaptureFocus()
	
	-- เริ่มนับถอยหลัง
	local time = GameConfig.Quiz.EasyTime
	if difficulty == "Medium" then
		time = GameConfig.Quiz.MediumTime
	elseif difficulty == "Hard" then
		time = GameConfig.Quiz.HardTime
	end
	
	startTimer(time)
	
	print("📱 [QUIZ DEBUG] แสดง UI! Timer:", time, "วินาที")
end)

-- ==========================================
-- ✅ ส่งคำตอบ
-- ==========================================
local function submitAnswer()
	if not isQuizActive then return end
	
	local answer = answerBox.Text
	if answer == "" then
		hintLabel.Text = "⚠️ กรุณาพิมพ์คำตอบ!"
		hintLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end
	
	local timeTaken = tick() - quizStartTime
	print("📤 [QUIZ DEBUG] ส่งคำตอบ:", answer, "ใช้เวลา:", timeTaken, "วินาที")
	
	-- หยุด Timer
	if timerThread then
		task.cancel(timerThread)
	end
	
	submitButton.Active = false
	submitButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	
	local success, isCorrect = pcall(function()
		return CheckAnswer:InvokeServer(answer, currentItemReference, timeTaken)
	end)
	
	if success then
		if isCorrect then
			questionLabel.Text = "✅ ถูกต้อง!"
			questionLabel.TextColor3 = GameConfig.Colors.Success
			hintLabel.Text = "🎉 ยินดีด้วย!"
			hintLabel.TextColor3 = GameConfig.Colors.Success
			timerLabel.BackgroundColor3 = GameConfig.Colors.Success
		else
			questionLabel.Text = "❌ ผิด!"
			questionLabel.TextColor3 = GameConfig.Colors.Danger
			hintLabel.Text = "😢 ลองใหม่อีกครั้ง"
			hintLabel.TextColor3 = GameConfig.Colors.Danger
			timerLabel.BackgroundColor3 = GameConfig.Colors.Danger
		end
		
		task.wait(2)
		isQuizActive = false
		backdrop.Visible = false
		frame.Visible = false
		answerBox.Text = ""
		submitButton.Active = true
		submitButton.BackgroundColor3 = GameConfig.Colors.Success
	end
end

submitButton.MouseButton1Click:Connect(submitAnswer)

answerBox.FocusLost:Connect(function(enterPressed)
	if enterPressed and answerBox.Text ~= "" and isQuizActive then
