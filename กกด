CheckAnswer.OnServerInvoke = function(player, playerAnswer, itemRef)
	print("📝 [SERVER DEBUG] ได้รับคำตอบจาก", player.Name, ":", playerAnswer)
	
	local quizData = ActiveQuizzes[player.UserId]
	
	if not quizData then
		warn("⚠️ [SERVER DEBUG] ไม่พบโจทย์สำหรับ", player.Name)
		return false
	end
	
	-- ตรวจสอบว่าผู้เล่นปิดหน้าต่างหรือไม่
	if playerAnswer == "CLOSE" then
		print("❌ [SERVER DEBUG]", player.Name, "ปิดหน้าต่าง - ของหายไป")
		
		if quizData.item and quizData.item.Parent then
			quizData.item:Destroy()
		end
		
		ActiveQuizzes[player.UserId] = nil
		return false
	end
	
	-- แปลงคำตอบเป็นตัวเลข
	local numAnswer = tonumber(playerAnswer)
	
	if not numAnswer then
		warn("⚠️ [SERVER DEBUG] คำตอบไม่ใช่ตัวเลข:", playerAnswer)
		ActiveQuizzes[player.UserId] = nil
		if quizData.item and quizData.item.Parent then
			quizData.item:Destroy()
		end
		return false
	end
	
	print("🔍 [SERVER DEBUG] เปรียบเทียบ:", numAnswer, "==", quizData.answer)
	
	-- ตรวจสอบคำตอบ
	if numAnswer == quizData.answer then
		print("✅ [SERVER DEBUG]", player.Name, "ตอบถูก!")
		
		-- ให้รางวัล
		if _G.PlayerDataManager then
			_G.PlayerDataManager.AddMoney(player, 10)
			_G.PlayerDataManager.AddItem(player, "Mystery Item")
		end
		
		-- ลบของ
		if quizData.item and quizData.item.Parent then
			quizData.item:Destroy()
		end
		
		ActiveQuizzes[player.UserId] = nil
		return true
	else
		print("❌ [SERVER DEBUG]", player.Name, "ตอบผิด! คำตอบที่ถูก:", quizData.answer)
		
		-- ลบของ
		if quizData.item and quizData.item.Parent then
			quizData.item:Destroy()
		end
		
		ActiveQuizzes[player.UserId] = nil
		return false
	end
end

