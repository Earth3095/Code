wait(1)

local UpdatePlayerStats = ReplicatedStorage:WaitForChild("UpdatePlayerStats", 10)
if UpdatePlayerStats then
	UpdatePlayerStats.OnClientEvent:Connect(function(statType, value, maxValue)
		print("📩 [DEBUG] ได้รับข้อมูลจาก Server:", statType, value, maxValue)
		if statType == "HP" then
			updateHP(value, maxValue)
		elseif statType == "Stamina" then
			updateStamina(value, maxValue)
		elseif statType == "Money" then
			updateMoney(value)
		end
	end)
	print("✅ [DEBUG] เชื่อมต่อ UpdatePlayerStats สำเร็จ")
else
	warn("⚠️ [DEBUG] ไม่พบ UpdatePlayerStats ใน ReplicatedStorage")
end

