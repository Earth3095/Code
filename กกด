-- 📦 ฟังก์ชันดรอปของจากมอนสเตอร์
-- ==========================================
local function dropItem(monster, dropPosition)
	-- สร้างของที่ดรอป
	local droppedItem = Instance.new("Part")
	droppedItem.Name = "DroppedItem"
	droppedItem.Size = Vector3.new(2, 2, 2)
	droppedItem.Position = dropPosition + Vector3.new(0, 3, 0)
	droppedItem.BrickColor = BrickColor.new("Bright yellow")
	droppedItem.Material = Enum.Material.Neon
	droppedItem.Anchored = true
	droppedItem.CanCollide = false
	droppedItem.Parent = workspace
	
	-- เพิ่มมุมโค้งมน
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = droppedItem
	
	-- เพิ่มแสง
	local light = Instance.new("PointLight")
	light.Brightness = 2
	light.Range = 10
	light.Color = Color3.fromRGB(255, 200, 0)
	light.Parent = droppedItem
	
	-- เพิ่ม BillboardGui (ป้ายชื่อ)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 100, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.Parent = droppedItem
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "📦 ของ"
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 20
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.5
	label.Parent = billboard
	
	print("📦 [SERVER DEBUG] ดรอปของที่ตำแหน่ง:", dropPosition)
	
	-- ทำให้หมุนวนๆ
	spawn(function()
		while droppedItem.Parent do
			droppedItem.CFrame = droppedItem.CFrame * CFrame.Angles(0, math.rad(2), 0)
			wait(0.03)
		end
	end)
	
	-- ฟังก์ชันเมื่อผู้เล่นแตะของ
	droppedItem.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = game.Players:GetPlayerFromCharacter(character)
		
		if player and droppedItem.Parent then
			print("👤 [SERVER DEBUG]", player.Name, "แตะของ")
			
			-- ตรวจสอบว่ามีโจทย์อยู่แล้วหรือไม่
			if ActiveQuizzes[player.UserId] then
				warn("⚠️ [SERVER DEBUG]", player.Name, "มีโจทย์อยู่แล้ว!")
				return
			end
			
			-- สร้างโจทย์
			local question, answer = generateMathProblem()
			
			-- เก็บข้อมูลโจทย์
			ActiveQuizzes[player.UserId] = {
				answer = answer,
				item = droppedItem,
				timestamp = tick()
			}
			
			print("❓ [SERVER DEBUG] โจทย์:", question, "| คำตอบ:", answer)
			
			-- ส่งโจทย์ไปให้ผู้เล่น
			ShowMathQuiz:FireClient(player, question, droppedItem)
		end
	end)
	
	-- ลบของหลัง 60 วินาที
	Debris:AddItem(droppedItem, 60)
	
	return droppedItem
end

