local currentTargetItem = nil
local isCollecting = false

-- ==========================================
-- 🎯 ฟังก์ชันตรวจสอบว่าชี้อะไรอยู่
-- ==========================================
local function updateCrosshair()
	if isCollecting then
		return -- ถ้ากำลังเก็บของอยู่ ไม่ต้องเช็ค
	end
	
	-- ยิง Raycast จากกล้อง
	local camera = workspace.CurrentCamera
	local rayOrigin = camera.CFrame.Position
	local rayDirection = camera.CFrame.LookVector * 100 -- ระยะ 100 studs
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = {player.Character}
	
	local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
	
	if raycastResult then
		local hitPart = raycastResult.Instance
		
		-- ตรวจสอบว่าเป็น DroppedItem หรือไม่
		if hitPart and hitPart.Name == "DroppedItem" then
			currentTargetItem = hitPart
			
			-- เปลี่ยนสีเป้าเป็นเหลือง
			centerDot.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
			topLine.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
			bottomLine.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
			leftLine.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
			rightLine.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
			
			-- แสดงชื่อของ
			itemNameLabel.Text = "📦 ของลึกลับ"
			itemNameLabel.Visible = true
			hintLabel.Visible = true
			
			return
		end
	end
	
	-- ไม่มีของ → รีเซ็ต
	currentTargetItem = nil
	centerDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	topLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bottomLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	leftLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	rightLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	itemNameLabel.Visible = false
	hintLabel.Visible = false
end

-- อัปเดตทุก 0.1 วินาที
spawn(function()
	while true do
		updateCrosshair()
		wait(0.1)
	end
end)

