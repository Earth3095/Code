local function createPortal(stageNumber)
	local stageConfig = GameConfig.Stages[stageNumber]
	if not stageConfig then return end
	
	local nextStageConfig = GameConfig.Stages[stageNumber + 1]
	if not nextStageConfig then
		print("⚠️ [PORTAL DEBUG] ด่าน", stageNumber, "เป็นด่านสุดท้าย")
		return
	end
	
	-- สร้าง Folder
	local portalsFolder = workspace:FindFirstChild("Portals")
	if not portalsFolder then
		portalsFolder = Instance.new("Folder")
		portalsFolder.Name = "Portals"
		portalsFolder.Parent = workspace
	end
	
	-- สร้างประตู
	local portal = Instance.new("Part")
	portal.Name = "Portal_Stage" .. stageNumber
	portal.Size = Vector3.new(8, 10, 1)
	portal.Position = stageConfig.PortalPosition
	portal.Anchored = true
	portal.CanCollide = false
	portal.Material = Enum.Material.Neon
	portal.BrickColor = BrickColor.new("Bright blue")
	portal.Transparency = 0.3
	portal.Parent = portalsFolder
	
	-- เอฟเฟกต์หมุน
	spawn(function()
		while portal.Parent do
			portal.CFrame = portal.CFrame * CFrame.Angles(0, math.rad(2), 0)
			wait(0.03)
		end
	end)
	
	-- Billboard
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 200, 0, 100)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.Parent = portal
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0.5, 0)
	label.BackgroundTransparency = 1
	label.Text = "🚪 ประตู"
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 32
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.5
	label.Parent = billboard
	
	local destLabel = Instance.new("TextLabel")
	destLabel.Size = UDim2.new(1, 0, 0.5, 0)
	destLabel.Position = UDim2.new(0, 0, 0.5, 0)
	destLabel.BackgroundTransparency = 1
	destLabel.Text = "→ " .. nextStageConfig.Name
	destLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
	destLabel.TextSize = 24
	destLabel.Font = Enum.Font.Gotham
	destLabel.TextStrokeTransparency = 0.5
	destLabel.Parent = billboard
	
	-- แตะประตู → Teleport
	portal.Touched:Connect(function(hit)
