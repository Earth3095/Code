UpgradeStat.OnServerInvoke = function(player, statName)
	local data = PlayerData[player.UserId]
	if not data or data.SkillPoints <= 0 then
		return false
	end
	
	data.SkillPoints = data.SkillPoints - 1
	
	if statName == "HP" then
		data.BonusHP = data.BonusHP + 10
		data.MaxHP = GameConfig.Player.MaxHealth + data.BonusHP
		data.HP = math.min(data.HP + 10, data.MaxHP)
		updatePlayerStat(player, "HP", data.HP, data.MaxHP)
	elseif statName == "Stamina" then
		data.BonusStamina = data.BonusStamina + 10
		data.MaxStamina = GameConfig.Player.MaxStamina + data.BonusStamina
		data.Stamina = math.min(data.Stamina + 10, data.MaxStamina)
		updatePlayerStat(player, "Stamina", data.Stamina, data.MaxStamina)
	elseif statName == "Damage" then
		data.BonusDamage = data.BonusDamage + 5
	elseif statName == "Speed" then
		data.BonusSpeed = data.BonusSpeed + 2
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChild("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = GameConfig.Player.WalkSpeed + data.BonusSpeed
			end
		end
	end
	
	print("⭐ [MASTER SERVER]", player.Name, "อัพสกิล:", statName)
	return true
end

-- ==========================================
-- 👑 ระบบ Admin
-- ==========================================
AdminCommand.OnServerInvoke = function(player, command, arg)
	if not isAdmin(player) then
		warn("⚠️ [MASTER SERVER]", player.Name, "ไม่ใช่ Admin!")
		return false
	end
	
	print("👑 [MASTER SERVER] คำสั่ง:", command, "จาก:", player.Name)
	
	if command == "god" then
		-- God Mode (ยังไม่ได้ทำ - ต้องใช้ Connection)
		return true
	elseif command == "fly" then
		-- Fly (ยังไม่ได้ทำ - ต้องใช้ BodyVelocity)
		return true
	elseif command == "killall" then
		for _, p in pairs(Players:GetPlayers()) do
			if p.Character then
				local h = p.Character:FindFirstChild("Humanoid")
				if h then h.Health = 0 end
			end
		end
		return true
	elseif command == "healall" then
		for _, p in pairs(Players:GetPlayers()) do
			if p.Character then
				local h = p.Character:FindFirstChild("Humanoid")
				if h then h.Health = h.MaxHealth end
			end
		end
		return true
	elseif command == "givemoney" then
		addMoney(player, 1000)
		return true
	elseif command == "killmonsters" then
		local monstersFolder = workspace:FindFirstChild("Monsters")
		if monstersFolder then
			for _, m in pairs(monstersFolder:GetChildren()) do
				if m:IsA("Model") then
					local h = m:FindFirstChild("Humanoid")
					if h then h.Health = 0 end
				end
			end
		end
		return true
	elseif command == "clearitems" then
		local itemsFolder = workspace:FindFirstChild("DroppedItems")
		if itemsFolder then
			itemsFolder:ClearAllChildren()
		end
		return true
	elseif command == "settime" then
		Lighting.ClockTime = arg or 12
		return true
	end
	
	return false
end

