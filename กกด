มาเริ่มกันเลยครับ!

📦 สิ่งที่คุณต้องเตรียม:

สร้าง Part ในเกม (เป็นของที่เก็บได้) ตั้งชื่อว่า CollectableItem
ใส่ Script ใน ServerScriptService
ใส่ LocalScript ใน StarterGui หรือ StarterPlayer > StarterPlayerScripts


🎮 1. Script หลัก (Server-side)
ใส่ใน ServerScriptService:
lualocal ReplicatedStorage = game:GetService("ReplicatedStorage")

-- สร้าง RemoteEvent สำหรับสื่อสารระหว่าง Server-Client
local ShowMathQuiz = Instance.new("RemoteEvent")
ShowMathQuiz.Name = "ShowMathQuiz"
ShowMathQuiz.Parent = ReplicatedStorage

local CheckAnswer = Instance.new("RemoteFunction")
CheckAnswer.Name = "CheckAnswer"
CheckAnswer.Parent = ReplicatedStorage

-- ตัวแปรเก็บคำตอบที่ถูกต้อง (สำหรับแต่ละผู้เล่น)
local correctAnswers = {}

-- ฟังก์ชันสร้างโจทย์คณิตศาสตร์แบบสุ่ม
local function generateMathProblem()
	local operations = {"+", "-", "*"}
	local operation = operations[math.random(1, #operations)]
	
	local num1 = math.random(1, 20)
	local num2 = math.random(1, 20)
	local answer
	
	if operation == "+" then
		answer = num1 + num2
	elseif operation == "-" then
		answer = num1 - num2
	elseif operation == "*" then
		answer = num1 * num2
	end
	
	local question = num1 .. " " .. operation .. " " .. num2 .. " = ?"
	return question, answer
end

-- เมื่อผู้เล่นแตะของ
local function onItemTouched(otherPart, item)
	local character = otherPart.Parent
	local player = game.Players:GetPlayerFromCharacter(character)
	
	if player and not correctAnswers[player.UserId] then
		-- สร้างโจทย์
		local question, answer = generateMathProblem()
		correctAnswers[player.UserId] = {answer = answer, item = item}
		
		-- ส่งโจทย์ไปให้ผู้เล่น
		ShowMathQuiz:FireClient(player, question)
	end
end

-- ตั้งค่าให้ทุก CollectableItem ใช้งานได้
for _, item in pairs(workspace:GetDescendants()) do
	if item:IsA("BasePart") and item.Name == "CollectableItem" then
		item.Touched:Connect(function(otherPart)
			onItemTouched(otherPart, item)
		end)
	end
end

-- ตรวจคำตอบ
CheckAnswer.OnServerInvoke = function(player, playerAnswer)
	local data = correctAnswers[player.UserId]
	
	if data then
		if tonumber(playerAnswer) == data.answer then
			-- ถูกต้อง! ให้ไอเทม
			correctAnswers[player.UserId] = nil
			data.item:Destroy() -- ลบของออกจากเกม
			return true
		else
			-- ผิด! ของหายไป
			correctAnswers[player.UserId] = nil
			data.item:Destroy()
			return false
		end
	end
	
	return false
end

