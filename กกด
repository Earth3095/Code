lua-- แทนที่: ServerScriptService > AdminSystem > toggleFly

local function toggleFly(targetName)
	local target = Players:FindFirstChild(targetName)
	if not target or not target.Character then return false end
	
	local humanoid = target.Character:FindFirstChild("Humanoid")
	local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return false end
	
	if flyingPlayers[target.UserId] then
		-- ปิด Fly
		if flyingPlayers[target.UserId].BodyGyro then
			flyingPlayers[target.UserId].BodyGyro:Destroy()
		end
		if flyingPlayers[target.UserId].BodyVelocity then
			flyingPlayers[target.UserId].BodyVelocity:Destroy()
		end
		flyingPlayers[target.UserId] = nil
		print("🦅 [ADMIN SERVER] ปิด Fly:", targetName)
	else
		-- เปิด Fly
		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(0, 0, 0) -- ปิดก่อน
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.Parent = rootPart
		
		local bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(9000, 9000, 9000)
		bodyGyro.P = 9000
		bodyGyro.Parent = rootPart
		
		flyingPlayers[target.UserId] = {
			BodyVelocity = bodyVelocity,
			BodyGyro = bodyGyro
		}
		
		-- ส่งสัญญาณไปยัง Client เพื่อควบคุม
		local ControlFly = ReplicatedStorage:FindFirstChild("ControlFly")
		if ControlFly then
			ControlFly:FireClient(target, true)
		end
		
		print("🦅 [ADMIN SERVER] เปิด Fly:", targetName)
	end
	
	return true
end

