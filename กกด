-- ==========================================
local function savePlayerData(player)
	-- รอให้ PlayerDataManager โหลดก่อน
	if not _G.PlayerDataManager then
		warn("⚠️ [AUTOSAVE]", player.Name, "- PlayerDataManager ยังไม่โหลด!")
		return false
	end
	
	local data = _G.PlayerDataManager.GetData(player)
	
	if not data then
		warn("⚠️ [AUTOSAVE]", player.Name, "- ไม่พบข้อมูล!")
		return false
	end
	
	-- สร้างข้อมูลที่จะบันทึก
	local saveData = {
		HP = data.HP,
		MaxHP = data.MaxHP,
		Stamina = data.Stamina,
		MaxStamina = data.MaxStamina,
		Money = data.Money,
		Stage = data.Stage,
		Inventory = data.Inventory,
		LastSave = os.time()
	}
	
	-- บันทึกข้อมูล
	local success, errorMessage = pcall(function()
		PlayerDataStore:SetAsync(player.UserId, saveData)
	end)
	
	if success then
		print("✅ [AUTOSAVE]", player.Name, "บันทึกข้อมูลสำเร็จ!")
		print("   - HP:", data.HP, "/", data.MaxHP)
		print("   - Stamina:", data.Stamina, "/", data.MaxStamina)
		print("   - Money:", data.Money)
		print("   - Stage:", data.Stage)
		print("   - Items:", #data.Inventory)
		return true
	else
		warn("❌ [AUTOSAVE]", player.Name, "บันทึกข้อมูลล้มเหลว:", errorMessage)
		return false
	end
end

-- ==========================================
-- 📂 ฟังก์ชันโหลดข้อมูล
-- ==========================================
local function loadPlayerData(player)
	print("📂 [AUTOSAVE] กำลังโหลดข้อมูลของ", player.Name, "...")
	
	local success, savedData = pcall(function()
		return PlayerDataStore:GetAsync(player.UserId)
	end)
	
	if success and savedData then
		print("✅ [AUTOSAVE]", player.Name, "โหลดข้อมูลสำเร็จ!")
		print("   - HP:", savedData.HP or 100, "/", savedData.MaxHP or 100)
		print("   - Money:", savedData.Money or 0)
		print("   - Stage:", savedData.Stage or 1)
		print("   - Last Save:", savedData.LastSave and os.date("%Y-%m-%d %H:%M:%S", savedData.LastSave) or "ไม่มีข้อมูล")
		
		-- รอให้ PlayerDataManager พร้อม
		wait(1)
		
		if _G.PlayerDataManager then
			local data = _G.PlayerDataManager.GetData(player)
			if data then
				-- นำข้อมูลที่โหลดมาใส่
				data.HP = savedData.HP or 100
				data.MaxHP = savedData.MaxHP or 100
				data.Stamina = savedData.Stamina or 100
				data.MaxStamina = savedData.MaxStamina or 100
				data.Money = savedData.Money or 0
				data.Stage = savedData.Stage or 1
				data.Inventory = savedData.Inventory or {}
				
				-- อัปเดต Leaderboard
				local leaderstats = player:FindFirstChild("leaderstats")
				if leaderstats then
					local stage = leaderstats:FindFirstChild("Stage")
					if stage then
						stage.Value = data.Stage
					end
				end
				
				-- อัปเดต UI
				_G.PlayerDataManager.UpdateStat(player, "HP", data.HP, data.MaxHP)
				_G.PlayerDataManager.UpdateStat(player, "Stamina", data.Stamina, data.MaxStamina)
				_G.PlayerDataManager.UpdateStat(player, "Money", data.Money)
				
				print("✅ [AUTOSAVE]", player.Name, "นำข้อมูลเข้าระบบสำเร็จ!")
			end
		end
		
		return savedData
	elseif success then
		print("📝 [AUTOSAVE]", player.Name, "ไม่มีข้อมูลเดิม - สร้างข้อมูลใหม่")
		return nil
	else
		warn("❌ [AUTOSAVE]", player.Name, "โหลดข้อมูลล้มเหลว:", savedData)
		return nil
	end
end

