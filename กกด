-- 🌟 God Mode
-- ==========================================
local godModePlayers = {}

local function toggleGodMode(targetName)
	local target = Players:FindFirstChild(targetName)
	if not target or not target.Character then return false end
	
	local humanoid = target.Character:FindFirstChild("Humanoid")
	if not humanoid then return false end
	
	if godModePlayers[target.UserId] then
		godModePlayers[target.UserId]:Disconnect()
		godModePlayers[target.UserId] = nil
		print("🌟 [ADMIN SERVER] ปิด God Mode:", targetName)
	else
		godModePlayers[target.UserId] = humanoid.HealthChanged:Connect(function(health)
			if health < humanoid.MaxHealth then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
		humanoid.Health = humanoid.MaxHealth
		print("🌟 [ADMIN SERVER] เปิด God Mode:", targetName)
	end
	
	return true
end

-- ==========================================
-- 🦅 Fly Mode
-- ==========================================
local flyingPlayers = {}

local function toggleFly(targetName)
	local target = Players:FindFirstChild(targetName)
	if not target or not target.Character then return false end
	
	local humanoid = target.Character:FindFirstChild("Humanoid")
	local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return false end
	
	if flyingPlayers[target.UserId] then
		flyingPlayers[target.UserId]:Destroy()
		flyingPlayers[target.UserId] = nil
		print("🦅 [ADMIN SERVER] ปิด Fly:", targetName)
	else
		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.Parent = rootPart
		
		flyingPlayers[target.UserId] = bodyVelocity
		print("🦅 [ADMIN SERVER] เปิด Fly:", targetName)
	end
	
	return true
end

-- ==========================================
-- 📍 Bring Player
-- ==========================================
local function bringPlayer(targetName, adminName)
	local target = Players:FindFirstChild(targetName)
	local admin = Players:FindFirstChild(adminName)
	
	if not target or not admin then return false end
	if not target.Character or not admin.Character then return false end
	
	local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
	local adminRoot = admin.Character:FindFirstChild("HumanoidRootPart")
	
	if targetRoot and adminRoot then
		targetRoot.CFrame = adminRoot.CFrame + adminRoot.CFrame.LookVector * 5
		print("📍 [ADMIN SERVER] Teleport:", targetName, "→", adminName)
		return true
	end
	
	return false
end

-- ==========================================
-- 🎮 Admin Command Handler
-- ==========================================
AdminCommand.OnServerInvoke = function(player, command, arg)
	-- ตรวจสอบ Admin (ใช้ Username)
	if not isAdmin(player) then
		warn("⚠️ [ADMIN SERVER]", player.Name, "ไม่ใช่ Admin!")
		return false
	end
	
	print("👑 [ADMIN SERVER] คำสั่ง:", command, "จาก", player.Name, "| Arg:", arg)
	
	if command == "kill" then
		return killPlayer(arg)
	elseif command == "killall" then
		return killAll()
	elseif command == "heal" then
		return healPlayer(arg)
	elseif command == "healall" then
		return healAll()
	elseif command == "givemoney" then
		return giveMoney(arg or player.Name, 1000)
	elseif command == "spawnmonster" then
		local pos = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position
		return spawnMonster(arg, pos)
	elseif command == "killmonsters" then
		return killAllMonsters()
	elseif command == "clearitems" then
		return clearDroppedItems()
	elseif command == "settime" then
		return setTime(arg)
	elseif command == "giveitem" then
		return giveItem(player.Name, arg)
	elseif command == "god" then
		return toggleGodMode(player.Name)
	elseif command == "fly" then
		return toggleFly(player.Name)
	elseif command == "bring" then
		return bringPlayer(arg, player.Name)
	else
		warn("⚠️ [ADMIN SERVER] คำสั่งไม่รู้จัก:", command)
		return false
	end
end

