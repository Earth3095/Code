-- เมื่อใช้งาน Tool (คลิก)
tool.Activated:Connect(function()
	local player = game.Players:GetPlayerFromCharacter(tool.Parent)
	
	if player then
		-- สร้างโจทย์ใหม่
		local question, answer = generateMathProblem()
		correctAnswers[player.UserId] = answer
		
		-- ส่งโจทย์ไปให้ผู้เล่น
		ShowMathQuiz:FireClient(player, question)
	end
