-- ✅ ส่งคำตอบ
-- ==========================================
local function submitAnswer()
	if not isQuizActive then
		warn("⚠️ [DEBUG] ไม่มีโจทย์ให้ตอบ")
		return
	end
	
	local answer = answerBox.Text
	
	if answer == "" then
		hintLabel.Text = "⚠️ กรุณาพิมพ์คำตอบก่อน!"
		hintLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end
	
	print("📤 [DEBUG] ส่งคำตอบ:", answer)
	
	-- ปิดการใช้งานปุ่ม (ป้องกันกดซ้ำ)
	submitButton.Active = false
	submitButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	
	-- ส่งไปยัง Server
	local success, isCorrect = pcall(function()
		return CheckAnswer:InvokeServer(answer, currentItemReference)
	end)
	
	if success then
		if isCorrect then
			questionLabel.Text = "✅ ถูกต้อง! ได้ของแล้ว"
			questionLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
			hintLabel.Text = "🎉 ยินดีด้วย! กำลังปิดหน้าต่าง..."
			hintLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
			print("🎉 [DEBUG] ตอบถูก!")
		else
			questionLabel.Text = "❌ ผิด! ของหายไป"
			questionLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			hintLabel.Text = "😢 เสียใจด้วย! ของหายไปแล้ว"
			hintLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			print("😢 [DEBUG] ตอบผิด!")
		end
		
		-- รอแล้วปิด
		wait(2.5)
		isQuizActive = false
		currentItemReference = nil
		frame.Visible = false
		answerBox.Text = ""
		submitButton.Active = true
		submitButton.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
	else
		warn("⚠️ [DEBUG] เกิดข้อผิดพลาดในการส่งคำตอบ:", isCorrect)
		submitButton.Active = true
		submitButton.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
	end
end

submitButton.MouseButton1Click:Connect(submitAnswer)

