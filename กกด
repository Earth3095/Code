local isQuizActive = false
local currentItemReference = nil
local quizStartTime = 0
local timerThread = nil
local maxTime = 30

-- ==========================================
-- ⏱️ ฟังก์ชันนับถอยหลัง
-- ==========================================
local function startTimer(seconds)
	maxTime = seconds
	
	if timerThread then
		task.cancel(timerThread)
	end
	
	timerThread = task.spawn(function()
		local remaining = seconds
		
		while remaining > 0 and isQuizActive do
			timerLabel.Text = tostring(remaining)
			
			-- เปลี่ยนสี
			if remaining <= 5 then
				timerLabel.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- แดงสด
				timerLabel.TextSize = 56 -- ขยายตัว
			elseif remaining <= 10 then
				timerLabel.BackgroundColor3 = Color3.fromRGB(255, 100, 0) -- ส้ม
				timerLabel.TextSize = 52
			else
				timerLabel.BackgroundColor3 = Color3.fromRGB(50, 200, 255) -- ฟ้า
				timerLabel.TextSize = 48
			end
			
			task.wait(1)
			remaining = remaining - 1
		end
		
		-- หมดเวลา!
		if remaining <= 0 and isQuizActive then
			print("⏰ [QUIZ DEBUG] หมดเวลา!")
			
			timerLabel.Text = "0"
			timerLabel.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
			
			questionLabel.Text = "⏰ หมดเวลา!"
			questionLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			hintLabel.Text = "⏰ หมดเวลาตอบโจทย์"
			hintLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			
			-- ส่งคำตอบผิด
			task.wait(1)
			
			pcall(function()
				CheckAnswer:InvokeServer("TIMEOUT", currentItemReference, maxTime + 1)
			end)
			
			task.wait(1.5)
			isQuizActive = false
			backdrop.Visible = false
			frame.Visible = false
			answerBox.Text = ""
		end
	end)
end

