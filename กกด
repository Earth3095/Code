local function setupSafeZone(stageNumber)
	local stageConfig = GameConfig.Stages[stageNumber]
	if not stageConfig or not stageConfig.IsSafeZone then return end
	
	print("🛡️ [SAFEZONE DEBUG] ตั้งค่า Safe Zone:", stageConfig.Name)
	
	-- สร้างโซนปลอดภัย
	local safeZone = Instance.new("Part")
	safeZone.Name = "SafeZone_Stage" .. stageNumber
	safeZone.Size = Vector3.new(50, 20, 50)
	safeZone.Position = stageConfig.SpawnPoint
	safeZone.Anchored = true
	safeZone.CanCollide = false
	safeZone.Transparency = 0.8
	safeZone.BrickColor = BrickColor.new("Lime green")
	safeZone.Material = Enum.Material.ForceField
	safeZone.Parent = workspace
	
	-- ป้องกันมอนสเตอร์เข้า
	safeZone.Touched:Connect(function(hit)
		local character = hit.Parent
		if character and character:FindFirstChild("Humanoid") then
			-- ตรวจสอบว่าเป็นมอนสเตอร์หรือไม่
			local isMonster = character.Parent == workspace:FindFirstChild("Monsters")
			if isMonster then
				-- ดันมอนสเตอร์ออก
				local rootPart = character:FindFirstChild("HumanoidRootPart")
				if rootPart then
					local direction = (rootPart.Position - safeZone.Position).Unit
					rootPart.CFrame = rootPart.CFrame + direction * 10
					print("🛡️ [SAFEZONE DEBUG] ดันมอนสเตอร์ออกจาก Safe Zone")
				end
			end
		end
	end)
	
	-- Billboard
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 12, 0)
	billboard.Parent = safeZone
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "🛡️ SAFE ZONE"
	label.TextColor3 = Color3.fromRGB(0, 255, 100)
	label.TextSize = 28
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.5
	label.Parent = billboard
	
	print("✅ [SAFEZONE DEBUG] Safe Zone พร้อม:", stageConfig.Name)
	return safeZone
end

