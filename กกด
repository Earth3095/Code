-- ==========================================
AttackMonster.OnServerEvent:Connect(function(player)
	local character = player.Character
	if not character then return end
	
	local humanoid = character:FindFirstChild("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end
	
	print("⚔️ [COMBAT DEBUG]", player.Name, "โจมตี!")
	
	-- หามอนสเตอร์ใกล้ที่สุด
	local monstersFolder = workspace:FindFirstChild("Monsters")
	if not monstersFolder then
		warn("⚠️ [COMBAT DEBUG] ไม่พบ Monsters Folder")
		return
	end
	
	local nearestMonster = nil
	local shortestDistance = 10 -- ระยะโจมตี 10 studs
	
	for _, monster in pairs(monstersFolder:GetChildren()) do
		if monster:IsA("Model") then
			local monsterRoot = monster:FindFirstChild("HumanoidRootPart")
			if monsterRoot then
				local distance = (rootPart.Position - monsterRoot.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					nearestMonster = monster
				end
			end
		end
	end
	
	if nearestMonster then
		local monsterHumanoid = nearestMonster:FindFirstChild("Humanoid")
		if monsterHumanoid and monsterHumanoid.Health > 0 then
			-- คำนวณดาเมจ
			local baseDamage = 10
			local bonusDamage = 0
			
			-- เพิ่มดาเมจจาก Level System
			if _G.LevelSystem then
				local levelData = _G.LevelSystem.GetData(player)
				if levelData then
					bonusDamage = levelData.BonusDamage or 0
				end
			end
			
			local totalDamage = baseDamage + bonusDamage
			
			-- โจมตี!
			monsterHumanoid:TakeDamage(totalDamage)
			
			-- แท็กผู้ฆ่า (สำหรับให้รางวัล)
			local creatorTag = Instance.new("ObjectValue")
			creatorTag.Name = "creator"
			creatorTag.Value = player
			creatorTag.Parent = monsterHumanoid
			
			game:GetService("Debris"):AddItem(creatorTag, 2)
			
			print("⚔️ [COMBAT DEBUG]", player.Name, "ตี", nearestMonster.Name, "เสียหาย:", totalDamage)
			print("   มอนสเตอร์เหลือ HP:", monsterHumanoid.Health, "/", monsterHumanoid.MaxHealth)
		end
	else
		print("⚠️ [COMBAT DEBUG]", player.Name, "ไม่มีมอนสเตอร์ใกล้ๆ")
	end
end)

