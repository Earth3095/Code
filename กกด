local function collectItem()
	if isCollecting then
		print("⚠️ [DEBUG] กำลังเก็บของอยู่แล้ว!")
		return
	end
	
	if not currentTargetItem then
		print("⚠️ [DEBUG] ไม่ได้ชี้ของอยู่!")
		return
	end
	
	print("📦 [DEBUG] พยายามเก็บของ:", currentTargetItem:GetFullName())
	
	isCollecting = true
	
	-- ปิดป้าย
	itemNameLabel.Visible = false
	hintLabel.Visible = false
	
	-- ส่งคำขอเก็บของไปยัง Server
	local success, result = pcall(function()
		return CollectItem:InvokeServer(currentTargetItem)
	end)
	
	if success then
		if result then
			print("✅ [DEBUG] เก็บของสำเร็จ!")
		else
			print("❌ [DEBUG] เก็บของล้มเหลว (อาจถูกเก็บไปแล้ว)")
		end
	else
		warn("⚠️ [DEBUG] เกิดข้อผิดพลาด:", result)
	end
	
	currentTargetItem = nil
	wait(0.5)
	isCollecting = false
end

