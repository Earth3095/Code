	local data = PlayerData[player.UserId]
	if not data then return false end
	
	local saveData = {
		HP = data.HP,
		MaxHP = data.MaxHP,
		Stamina = data.Stamina,
		MaxStamina = data.MaxStamina,
		Money = data.Money,
		Stage = data.Stage,
		Level = data.Level,
		CurrentExp = data.CurrentExp,
		SkillPoints = data.SkillPoints,
		BonusHP = data.BonusHP,
