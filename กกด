local function isAdmin(player)
	for _, adminName in ipairs(GameConfig.Admins) do
		if player.Name == adminName then
			return true
		end
	end
	return false
end

local function generateMathProblem()
	local ops = {"+", "-", "*"}
	local op = ops[math.random(1, #ops)]
	local num1 = math.random(1, 20)
	local num2 = math.random(1, 20)
	local answer
	
	if op == "+" then
		answer = num1 + num2
	elseif op == "-" then
		if num1 < num2 then num1, num2 = num2, num1 end
		answer = num1 - num2
	else
		num1 = math.random(1, 10)
		num2 = math.random(1, 10)
		answer = num1 * num2
	end
	
	return num1 .. " " .. op .. " " .. num2 .. " = ?", answer
end

CollectItem.OnServerInvoke = function(player, item)
	if not item or not item.Parent then
		return false, "ของไม่มีแล้ว"
	end
	
	-- Admin ได้ของเลย!
	if isAdmin(player) and GameConfig.Money.AdminAutoCollect then
		print("👑 [MASTER SERVER] Admin:", player.Name, "เก็บของโดยไม่ต้องทำโจทย์")
		addMoney(player, GameConfig.Money.KillMonsterReward)
		addExp(player, 30)
		item:Destroy()
		return true, "Admin: ได้ของแล้ว"
	end
	
	-- ตรวจสอบระยะ
	local character = player.Character
	if not character then return false, "ไม่พบตัวละคร" end
	
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return false, "ไม่พบ RootPart" end
	
	local distance = (rootPart.Position - item.Position).Magnitude
	if distance > 15 then
		return false, "ไกลเกินไป"
	end
	
	-- เช็คว่าต้องทำโจทย์หรือไม่
	if not GameConfig.Quiz.Enabled then
		-- ได้เงินเลย!
		addMoney(player, GameConfig.Money.KillMonsterReward)
		addExp(player, 30)
		item:Destroy()
		print("💰 [MASTER SERVER]", player.Name, "เก็บของสำเร็จ (ไม่ต้องทำโจทย์)")
		return true, "ได้ของแล้ว"
	end
	
	-- ต้องทำโจทย์
	if ActiveQuizzes[player.UserId] then
		return false, "มีโจทย์อยู่แล้ว"
	end
	
	local currentTime = tick()
	local lastTime = LastQuizTime[player.UserId] or 0
	if currentTime - lastTime < 1 then
		return false, "รอสักครู่"
	end
	
	LastQuizTime[player.UserId] = currentTime
	
	local question, answer = generateMathProblem()
	local itemId = item:FindFirstChild("ItemID")
	
	ActiveQuizzes[player.UserId] = {
		answer = answer,
		item = item,
		itemId = itemId and itemId.Value or "",
		timestamp = currentTime,
	}
	
	if GameConfig.Quiz.ShowAnswerInOutput and isAdmin(player) then
		print("🔑 [ADMIN ONLY] คำตอบ:", answer)
	end
	
	ShowMathQuiz:FireClient(player, question, itemId and itemId.Value or "")
	print("📝 [MASTER SERVER] ส่งโจทย์:", player.Name)
	
	return true, "กำลังทำโจทย์"
end

