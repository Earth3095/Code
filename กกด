-- ต่อเข้ากับ MonsterAI หรือ ItemDropSystem
local function onMonsterKilled(killer, monsterLevel)
	if not killer or not killer:IsA("Player") then return end
	
	local expReward = 20 + (monsterLevel * 10) -- Lv1 = 30 EXP, Lv2 = 40 EXP
	addExp(killer, expReward)
end

-- Export ฟังก์ชัน
_G.LevelSystem = {
	AddExp = addExp,
	GetData = function(player)
		return PlayerLevels[player.UserId]
	end,
	OnMonsterKilled = onMonsterKilled,
}

