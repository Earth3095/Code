local PlayerData = {}

local function createPlayerData(player)
	PlayerData[player.UserId] = {
		HP = GameConfig.Player.StartingHealth,
		MaxHP = GameConfig.Player.MaxHealth,
		Stamina = GameConfig.Player.StartingStamina,
		MaxStamina = GameConfig.Player.MaxStamina,
		Money = GameConfig.Money.StartingMoney,
		Stage = 1,
		Level = 1,
		CurrentExp = 0,
		ExpToNextLevel = 150,
		SkillPoints = 0,
		BonusHP = 0,
		BonusStamina = 0,
		BonusDamage = 0,
		BonusSpeed = 0,
		Inventory = {},
	}
	return PlayerData[player.UserId]
end

local function updatePlayerStat(player, statType, value, maxValue)
	local data = PlayerData[player.UserId]
	if not data then return end
	
	if statType == "HP" then
		data.HP = math.clamp(value, 0, data.MaxHP)
		UpdatePlayerStats:FireClient(player, "HP", data.HP, data.MaxHP)
	elseif statType == "Stamina" then
		data.Stamina = math.clamp(value, 0, data.MaxStamina)
		UpdatePlayerStats:FireClient(player, "Stamina", data.Stamina, data.MaxStamina)
	elseif statType == "Money" then
		data.Money = math.max(0, value)
		UpdatePlayerStats:FireClient(player, "Money", data.Money)
	end
end

local function addMoney(player, amount)
	local data = PlayerData[player.UserId]
	if data then
		data.Money = data.Money + amount
		updatePlayerStat(player, "Money", data.Money)
	end
end

local function takeDamage(player, damage)
	local data = PlayerData[player.UserId]
	if data then
		data.HP = math.max(0, data.HP - damage)
		updatePlayerStat(player, "HP", data.HP, data.MaxHP)
		
		if data.HP <= 0 then
			local character = player.Character
			if character then
				local humanoid = character:FindFirstChild("Humanoid")
				if humanoid and humanoid.Health > 0 then
					humanoid.Health = 0
					print("💀 [MASTER SERVER]", player.Name, "ตาย!")
				end
			end
		end
	end
end

local function addExp(player, amount)
	local data = PlayerData[player.UserId]
	if not data then return end
	
	data.CurrentExp = data.CurrentExp + amount
	
	while data.CurrentExp >= data.ExpToNextLevel do
		data.CurrentExp = data.CurrentExp - data.ExpToNextLevel
		data.Level = data.Level + 1
		data.SkillPoints = data.SkillPoints + 1
		data.ExpToNextLevel = 100 + (data.Level * 50)
		
		print("🎉 [MASTER SERVER]", player.Name, "เลเวลอัพ! → Level", data.Level)
		LevelUp:FireClient(player, data.Level, data.SkillPoints)
		
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local levelValue = leaderstats:FindFirstChild("Level")
			if levelValue then
				levelValue.Value = data.Level
			end
		end
	end
end

