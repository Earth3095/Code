-- ✅ ตรวจคำตอบ
-- ==========================================
CheckAnswer.OnServerInvoke = function(player, playerAnswer, itemRef, timeTaken)
	print("==========================================")
	print("📝 [SERVER DEBUG] ตรวจคำตอบ")
	print("   ผู้เล่น:", player.Name)
	print("   คำตอบ:", playerAnswer)
	print("   Item ID:", itemRef)
	print("   เวลาที่ใช้:", timeTaken, "วินาที")
	
	local quizData = ActiveQuizzes[player.UserId]
	
	if not quizData then
		warn("⚠️ [SECURITY] ไม่พบโจทย์สำหรับ", player.Name)
		return false
	end
	
	-- 🔒 ตรวจสอบ Item ID
	if itemRef ~= quizData.itemId then
		warn("⚠️ [SECURITY]", player.Name, "ส่ง Item ID ไม่ถูกต้อง!")
		ActiveQuizzes[player.UserId] = nil
		return false
	end
	
	-- 🔒 ตรวจสอบเวลา
	if timeTaken and timeTaken < 0.5 then
		warn("⚠️ [SECURITY]", player.Name, "ส่งคำตอบเร็วเกินไป!")
		ActiveQuizzes[player.UserId] = nil
		if quizData.item and quizData.item.Parent then
			quizData.item:Destroy()
		end
		return false
	end
	
	-- 🔒 ตรวจสอบระยะห่าง
	local character = player.Character
	if character then
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if rootPart and quizData.item and quizData.item.Parent then
			local distance = (rootPart.Position - quizData.item.Position).Magnitude
			if distance > 50 then
				warn("⚠️ [SECURITY]", player.Name, "อยู่ไกลของเกินไป! ระยะ:", distance)
				ActiveQuizzes[player.UserId] = nil
				return false
			end
		end
	end
	
	-- ตรวจสอบว่ายกเลิกหรือไม่
	if playerAnswer == "CANCEL" then
		print("❌ [SERVER DEBUG]", player.Name, "ยกเลิกโจทย์")
		
		if quizData.item and quizData.item.Parent then
			local billboard = quizData.item:FindFirstChild("BillboardGui")
			if billboard then
				local label = billboard:FindFirstChild("TextLabel")
				local hintLabel = billboard:FindFirstChild("TextLabel")
				if label then
					label.Text = "📦 ของ"
					label.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
				if hintLabel and hintLabel ~= label then
					hintLabel.Text = "แตะเพื่อทำโจทย์"
				end
			end
		end
		
		ActiveQuizzes[player.UserId] = nil
		return false
	end
	
	-- แปลงคำตอบ
	local numAnswer = tonumber(playerAnswer)
	
	if not numAnswer then
		warn("⚠️ [SERVER DEBUG] คำตอบไม่ใช่ตัวเลข:", playerAnswer)
		ActiveQuizzes[player.UserId] = nil
		if quizData.item and quizData.item.Parent then
			quizData.item:Destroy()
		end
		return false
	end
	
	print("🔍 [SERVER DEBUG] เปรียบเทียบคำตอบ:")
	print("   ผู้เล่นตอบ:", numAnswer)
	print("   คำตอบที่ถูก:", quizData.answer)
	
	-- ตรวจสอบคำตอบ
	if numAnswer == quizData.answer then
		print("✅✅✅ [SERVER DEBUG] ตอบถูก! ✅✅✅")
		print("   ผู้เล่น:", player.Name)
		print("   ใช้เวลา:", timeTaken, "วินาที")
		
		-- ให้รางวัล
		if _G.PlayerDataManager then
			_G.PlayerDataManager.AddMoney(player, 10)
			_G.PlayerDataManager.AddItem(player, "Mystery Item")
			print("💰 [SERVER DEBUG] ให้รางวัล:", player.Name, "+10 เหรียญ")
		else
			warn("⚠️ [SERVER DEBUG] PlayerDataManager ยังไม่โหลด!")
		end
		
		-- ลบของ
		if quizData.item and quizData.item.Parent then
			print("🗑️ [SERVER DEBUG] กำลังลบของ...")
			
			-- แสดงเอฟเฟกต์ก่อนลบ
			local billboard = quizData.item:FindFirstChild("BillboardGui")
			if billboard then
				local label = billboard:FindFirstChild("TextLabel")
				if label then
					label.Text = "✅ ได้ของแล้ว!"
					label.TextColor3 = Color3.fromRGB(0, 255, 100)
				end
			end
			
			-- รอแล้วลบ
			wait(0.5)
			quizData.item:Destroy()
			print("✅ [SERVER DEBUG] ลบของเรียบร้อย!")
		end
		
		ActiveQuizzes[player.UserId] = nil
		print("==========================================")
		return true
		
	else
		print("❌❌❌ [SERVER DEBUG] ตอบผิด! ❌❌❌")
		print("   ผู้เล่น:", player.Name)
		print("   ตอบ:", numAnswer)
		print("   คำตอบที่ถูก:", quizData.answer)
		
		-- ลบของ
		if quizData.item and quizData.item.Parent then
			print("🗑️ [SERVER DEBUG] กำลังลบของ (ตอบผิด)...")
			
			-- แสดงเอฟเฟกต์
			local billboard = quizData.item:FindFirstChild("BillboardGui")
			if billboard then
				local label = billboard:FindFirstChild("TextLabel")
				if label then
					label.Text = "❌ ตอบผิด!"
					label.TextColor3 = Color3.fromRGB(255, 50, 50)
				end
			end
			
			wait(0.5)
			quizData.item:Destroy()
			print("✅ [SERVER DEBUG] ลบของเรียบร้อย!")
		end
		
		ActiveQuizzes[player.UserId] = nil
		print("==========================================")
		return false
	end
end

