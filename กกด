local function takeDamage(player, damage)
	local data = PlayerData[player.UserId]
	if data then
		data.HP = data.HP - damage
		
		-- ⬇️ เพิ่มส่วนนี้
		if data.HP < 0 then
			data.HP = 0
		end
		
		updatePlayerStat(player, "HP", data.HP, data.MaxHP)
		
		print("💥 [SERVER DEBUG]", player.Name, "โดนโจมตี! HP:", data.HP, "/", data.MaxHP)
		
		-- ตรวจสอบว่าตายหรือไม่
		if data.HP <= 0 then
			print("💀 [SERVER DEBUG] ผู้เล่น", player.Name, "ตาย!")
			
			-- ทำให้ตายจริงๆ
			local character = player.Character
			if character then
				local humanoid = character:FindFirstChild("Humanoid")
				if humanoid and humanoid.Health > 0 then
					humanoid.Health = 0
					print("💀 [SERVER DEBUG] บังคับให้ตาย:", player.Name)
				end
			end
		end
	end
end
