lua-- แทนที่: ServerScriptService > ShopSystem > BuyItem.OnServerInvoke

BuyItem.OnServerInvoke = function(player, itemName)
	print("🛒 [SHOP SERVER]", player.Name, "พยายามซื้อ:", itemName)
	
	local itemData = nil
	for _, item in ipairs(GameConfig.Shop.Items) do
		if item.Name == itemName then
			itemData = item
			break
		end
	end
	
	if not itemData then
		warn("⚠️ [SHOP SERVER] ไม่พบไอเทม:", itemName)
		return false, "ไม่พบสินค้านี้"
	end
	
	if not _G.PlayerDataManager then
		warn("⚠️ [SHOP SERVER] PlayerDataManager ไม่พร้อม")
		return false, "ระบบขัดข้อง"
	end
	
	local playerData = _G.PlayerDataManager.GetData(player)
	if not playerData then
		warn("⚠️ [SHOP SERVER] ไม่พบข้อมูล:", player.Name)
		return false, "ไม่พบข้อมูล"
	end
	
	if playerData.Money < itemData.Price then
		warn("⚠️ [SHOP SERVER]", player.Name, "เงินไม่พอ! มี:", playerData.Money, "ต้องการ:", itemData.Price)
		return false, "เงินไม่พอ"
	end
	
	-- หักเงิน
	playerData.Money = playerData.Money - itemData.Price
	_G.PlayerDataManager.UpdateStat(player, "Money", playerData.Money)
	
	-- ให้ไอเทม
	_G.PlayerDataManager.AddItem(player, itemName)
	
	print("✅ [SHOP SERVER]", player.Name, "ซื้อ:", itemName, "สำเร็จ!")
	return true, "ซื้อสำเร็จ"  -- ⬅️ แก้ตรงนี้ (return แบบเดิม)
end
