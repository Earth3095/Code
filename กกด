local function setupMonster(monster)
	local humanoid = monster:FindFirstChild("Humanoid")
	
	if not humanoid then
		warn("⚠️ [SERVER DEBUG] มอนสเตอร์ไม่มี Humanoid:", monster.Name)
		return
	end
	
	print("👾 [SERVER DEBUG] ตั้งค่ามอนสเตอร์:", monster.Name)
	print("   HP:", humanoid.Health, "/", humanoid.MaxHealth)
	
	-- เพิ่ม BillboardGui แสดง HP
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthBar"
	billboard.Size = UDim2.new(0, 100, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = monster:FindFirstChild("Head") or monster:FindFirstChild("HumanoidRootPart")
	
	-- พื้นหลัง HP Bar
	local bgFrame = Instance.new("Frame")
	bgFrame.Size = UDim2.new(1, 0, 0, 10)
	bgFrame.Position = UDim2.new(0, 0, 0, 20)
	bgFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	bgFrame.BorderSizePixel = 0
	bgFrame.Parent = billboard
	
	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 5)
	bgCorner.Parent = bgFrame
	
	-- HP Bar
	local hpBar = Instance.new("Frame")
	hpBar.Name = "HPBar"
	hpBar.Size = UDim2.new(1, 0, 1, 0)
	hpBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
	hpBar.BorderSizePixel = 0
	hpBar.Parent = bgFrame
	
	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(0, 5)
	hpCorner.Parent = hpBar
	
	-- ชื่อมอนสเตอร์
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0, 20)
	nameLabel.Position = UDim2.new(0, 0, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = humanoid.DisplayName or "มอนสเตอร์"
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextSize = 16
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.Parent = billboard
	
	-- HP Text
	local hpText = Instance.new("TextLabel")
	hpText.Name = "HPText"
	hpText.Size = UDim2.new(1, 0, 0, 10)
	hpText.Position = UDim2.new(0, 0, 0, 20)
	hpText.BackgroundTransparency = 1
	hpText.Text = math.floor(humanoid.Health) .. "/" .. humanoid.MaxHealth
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextSize = 12
	hpText.Font = Enum.Font.Gotham
	hpText.TextStrokeTransparency = 0.5
	hpText.ZIndex = 2
	hpText.Parent = billboard
	
	print("✅ [SERVER DEBUG] สร้าง Health Bar สำเร็จ")
	
	-- ==========================================
	-- 💥 เมื่อมอนสเตอร์โดนตี
	-- ==========================================
	humanoid.HealthChanged:Connect(function(health)
		local percent = health / humanoid.MaxHealth
		hpBar:TweenSize(
			UDim2.new(percent, 0, 1, 0),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			0.2,
			true
		)
		hpText.Text = math.floor(health) .. "/" .. humanoid.MaxHealth
		
		print("💥 [SERVER DEBUG]", monster.Name, "โดนตี! HP:", math.floor(health), "/", humanoid.MaxHealth)
	end)
	
	-- ==========================================
	-- 💀 เมื่อมอนสเตอร์ตาย
	-- ==========================================
	humanoid.Died:Connect(function()
		print("💀💀💀 [SERVER DEBUG] มอนสเตอร์ตาย:", monster.Name, "💀💀💀")
		
		-- หาตำแหน่งดรอปของ
		local rootPart = monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChild("Torso")
		if rootPart then
			local dropPosition = rootPart.Position
			print("📍 [SERVER DEBUG] ตำแหน่งดรอป:", dropPosition)
			
			-- ดรอปของ
			if _G.ItemDropSystem then
				_G.ItemDropSystem.DropItem(dropPosition, monster.Name)
				print("✅ [SERVER DEBUG] เรียก DropItem สำเร็จ!")
			else
				warn("⚠️ [SERVER DEBUG] ItemDropSystem ไม่พร้อม!")
			end
		else
			warn("⚠️ [SERVER DEBUG] ไม่พบ RootPart ของ", monster.Name)
		end
		
		-- ลบมอนสเตอร์หลัง 2 วินาที
		wait(2)
		monster:Destroy()
		print("🗑️ [SERVER DEBUG] ลบมอนสเตอร์:", monster.Name)
	end)
end

