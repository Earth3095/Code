-- ==========================================
-- 💾 ข้อมูลเลเวล (เก็บแยกจาก PlayerDataManager)
-- ==========================================
local PlayerLevels = {}

-- ==========================================
-- 📊 ตารางค่า EXP ต่อเลเวล
-- ==========================================
local function getExpForLevel(level)
	-- สูตร: EXP = 100 + (level * 50)
	-- Lv1 → Lv2 = 150 EXP
	-- Lv2 → Lv3 = 200 EXP
	-- Lv3 → Lv4 = 250 EXP
	return 100 + (level * 50)
end

-- ==========================================
-- ⭐ ฟังก์ชันเพิ่ม EXP
-- ==========================================
local function addExp(player, amount)
	local data = PlayerLevels[player.UserId]
	if not data then
		warn("⚠️ [LEVEL DEBUG] ไม่พบข้อมูลเลเวลของ", player.Name)
		return
	end
	
	data.CurrentExp = data.CurrentExp + amount
	print("✨ [LEVEL DEBUG]", player.Name, "ได้ EXP:", amount, "| รวม:", data.CurrentExp, "/", data.ExpToNextLevel)
	
	-- ตรวจสอบว่าเลเวลอัพหรือไม่
	while data.CurrentExp >= data.ExpToNextLevel do
		data.CurrentExp = data.CurrentExp - data.ExpToNextLevel
		data.Level = data.Level + 1
		data.SkillPoints = data.SkillPoints + 1 -- ได้ 1 Skill Point
		data.ExpToNextLevel = getExpForLevel(data.Level)
		
		print("🎉🎉🎉 [LEVEL DEBUG]", player.Name, "เลเวลอัพ! → Level", data.Level)
		
		-- แจ้ง Client
		LevelUp:FireClient(player, data.Level, data.SkillPoints)
		
		-- อัปเดต Leaderboard
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local levelValue = leaderstats:FindFirstChild("Level")
			if levelValue then
				levelValue.Value = data.Level
			end
		end
	end
end

-- ==========================================
-- 🎯 ฟังก์ชันอัพสกิล
-- ==========================================
UpgradeStat.OnServerInvoke = function(player, statName)
	local data = PlayerLevels[player.UserId]
	if not data then
		warn("⚠️ [LEVEL DEBUG] ไม่พบข้อมูลของ", player.Name)
		return false
	end
	
	-- ตรวจสอบ Skill Points
	if data.SkillPoints <= 0 then
		warn("⚠️ [LEVEL DEBUG]", player.Name, "ไม่มี Skill Points!")
		return false
	end
	
	print("⬆️ [LEVEL DEBUG]", player.Name, "อัพสกิล:", statName)
	
	-- ใช้ Skill Point
	data.SkillPoints = data.SkillPoints - 1
	
	-- เพิ่มค่าสถานะ
	if statName == "HP" then
		data.BonusHP = data.BonusHP + 10
		
		-- อัปเดต MaxHealth
		if _G.PlayerDataManager then
			local playerData = _G.PlayerDataManager.GetData(player)
			if playerData then
				playerData.MaxHP = GameConfig.Player.MaxHealth + data.BonusHP
				playerData.HP = math.min(playerData.HP + 10, playerData.MaxHP)
				_G.PlayerDataManager.UpdateStat(player, "HP", playerData.HP, playerData.MaxHP)
			end
		end
		
		print("✅ [LEVEL DEBUG] HP +10 | Total Bonus:", data.BonusHP)
		
	elseif statName == "Stamina" then
		data.BonusStamina = data.BonusStamina + 10
		
		if _G.PlayerDataManager then
			local playerData = _G.PlayerDataManager.GetData(player)
			if playerData then
				playerData.MaxStamina = GameConfig.Player.MaxStamina + data.BonusStamina
				playerData.Stamina = math.min(playerData.Stamina + 10, playerData.MaxStamina)
				_G.PlayerDataManager.UpdateStat(player, "Stamina", playerData.Stamina, playerData.MaxStamina)
			end
		end
		
		print("✅ [LEVEL DEBUG] Stamina +10 | Total Bonus:", data.BonusStamina)
		
	elseif statName == "Damage" then
		data.BonusDamage = data.BonusDamage + 5
		print("✅ [LEVEL DEBUG] Damage +5 | Total Bonus:", data.BonusDamage)
		
	elseif statName == "Speed" then
		data.BonusSpeed = data.BonusSpeed + 2
		
		-- อัปเดต WalkSpeed
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChild("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = GameConfig.Player.WalkSpeed + data.BonusSpeed
			end
		end
		
		print("✅ [LEVEL DEBUG] Speed +2 | Total Bonus:", data.BonusSpeed)
		
	else
		warn("⚠️ [LEVEL DEBUG] สกิลไม่รู้จัก:", statName)
		data.SkillPoints = data.SkillPoints + 1 -- คืน Skill Point
		return false
	end
	
	return true
end

