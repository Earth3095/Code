Players.PlayerAdded:Connect(function(player)
	print("⭐ [LEVEL DEBUG] ผู้เล่นเข้าเกม:", player.Name)
	
	-- สร้างข้อมูลเลเวล
	PlayerLevels[player.UserId] = {
		Level = 1,
		CurrentExp = 0,
		ExpToNextLevel = getExpForLevel(1),
		SkillPoints = 0,
		
		-- Bonus Stats
		BonusHP = 0,
		BonusStamina = 0,
		BonusDamage = 0,
		BonusSpeed = 0,
	}
	
	-- เพิ่ม Level ใน Leaderboard
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local levelValue = Instance.new("IntValue")
		levelValue.Name = "Level"
		levelValue.Value = 1
		levelValue.Parent = leaderstats
		print("✅ [LEVEL DEBUG] เพิ่ม Level ใน Leaderboard")
	end
	
	print("✅ [LEVEL DEBUG] สร้างข้อมูลเลเวลสำเร็จ")
end)

