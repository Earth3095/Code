local function submitAnswer()
	if not isQuizActive then
		warn("⚠️ [DEBUG] ไม่มีโจทย์ให้ตอบ")
		return
	end
	
	local answer = answerBox.Text
	
	if answer == "" then
		hintLabel.Text = "⚠️ กรุณาพิมพ์คำตอบก่อน!"
		hintLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end
	
	-- 🔒 ตรวจสอบเวลา (ป้องกันการส่งคำตอบเร็วผิดปกติ)
	local timeTaken = tick() - quizStartTime
	if timeTaken < 0.5 then
		warn("⚠️ [SECURITY] ส่งคำตอบเร็วเกินไป! (", timeTaken, "วินาที)")
		hintLabel.Text = "⚠️ ส่งคำตอบช้าลงหน่อย!"
		hintLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end
	
	print("📤 [DEBUG] ส่งคำตอบ:", answer, "| ใช้เวลา:", timeTaken, "วินาที")
	
	-- ปิดการใช้งานปุ่ม (ป้องกันกดซ้ำ)
	answerBox.Active = false
	submitButton.Active = false
	submitButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	cancelButton.Active = false
	
	-- ส่งไปยัง Server
	local success, isCorrect = pcall(function()
		return CheckAnswer:InvokeServer(answer, currentItemReference, timeTaken)
	end)
	
	if success then
		if isCorrect then
			questionLabel.Text = "✅ ถูกต้อง! ได้ของแล้ว"
			questionLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
			hintLabel.Text = "🎉 ยินดีด้วย! +10 เหรียญ"
			hintLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
