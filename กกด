local function dropItem(monster, dropPosition)
	print("📦 [SERVER DEBUG] กำลังสร้างของที่ดรอป...")
	
	-- สร้างของที่ดรอป
	local droppedItem = Instance.new("Part")
	droppedItem.Name = "DroppedItem"
	droppedItem.Size = Vector3.new(3, 3, 3)
	droppedItem.Position = dropPosition + Vector3.new(0, 3, 0)
	droppedItem.BrickColor = BrickColor.new("Bright yellow")
	droppedItem.Material = Enum.Material.Neon
	droppedItem.Anchored = true
	droppedItem.CanCollide = false
	droppedItem.Parent = workspace
	
	-- เพิ่ม Unique ID
	local itemId = Instance.new("StringValue")
	itemId.Name = "ItemID"
	itemId.Value = game:GetService("HttpService"):GenerateGUID(false)
	itemId.Parent = droppedItem
	
	-- สถานะของไอเทม
	local itemCollected = Instance.new("BoolValue")
	itemCollected.Name = "IsCollected"
	itemCollected.Value = false
	itemCollected.Parent = droppedItem
	
	-- เพิ่มมุมโค้งมน
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = droppedItem
	
	-- เพิ่มแสง
	local light = Instance.new("PointLight")
	light.Brightness = 3
	light.Range = 15
	light.Color = Color3.fromRGB(255, 200, 0)
	light.Parent = droppedItem
	
	-- เพิ่ม BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 150, 0, 80)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.Parent = droppedItem
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0.6, 0)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = "📦 ของ"
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 28
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard
	
	local hintLabel = Instance.new("TextLabel")
	hintLabel.Size = UDim2.new(1, 0, 0.4, 0)
	hintLabel.Position = UDim2.new(0, 0, 0.6, 0)
	hintLabel.BackgroundTransparency = 1
	hintLabel.Text = "แตะเพื่อทำโจทย์"
	hintLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	hintLabel.TextSize = 16
	hintLabel.Font = Enum.Font.Gotham
	hintLabel.TextStrokeTransparency = 0.5
	hintLabel.Parent = billboard
	
	print("✅ [SERVER DEBUG] สร้างของสำเร็จ | ID:", itemId.Value)
	print("   ตำแหน่ง:", dropPosition)
	
	-- ทำให้หมุนวนๆ
	spawn(function()
		while droppedItem.Parent do
			droppedItem.CFrame = droppedItem.CFrame * CFrame.Angles(0, math.rad(3), 0)
			wait(0.03)
		end
	end)
	
	-- ทำให้ลอยขึ้นลง
	spawn(function()
		local startPos = droppedItem.Position
		local time = 0
		while droppedItem.Parent do
			time = time + 0.05
			local offset = math.sin(time * 2) * 0.5
			droppedItem.Position = startPos + Vector3.new(0, offset, 0)
			wait(0.05)
		end
	end)
	
	-- ==========================================
	-- ⚠️ สำคัญ! เมื่อผู้เล่นแตะของ → แสดงโจทย์ก่อน
	-- ==========================================
	droppedItem.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = game.Players:GetPlayerFromCharacter(character)
		
		if player and droppedItem.Parent then
			print("👤 [SERVER DEBUG]", player.Name, "แตะของ | ID:", itemId.Value)
			
			-- 🔒 ตรวจสอบว่ามีโจทย์อยู่แล้วหรือไม่
			if ActiveQuizzes[player.UserId] then
				warn("⚠️ [SERVER DEBUG]", player.Name, "มีโจทย์อยู่แล้ว!")
				return
			end
			
			-- 🔒 ตรวจสอบว่าของนี้ถูกเก็บไปแล้วหรือยัง
			if itemCollected.Value then
				print("⚠️ [SERVER DEBUG] ของนี้ถูกเก็บไปแล้ว!")
				return
			end
			
			-- 🔒 ป้องกัน Spam
			local lastTime = LastQuizTime[player.UserId] or 0
			local currentTime = tick()
			if currentTime - lastTime < QUIZ_COOLDOWN then
				warn("⚠️ [SECURITY]", player.Name, "พยายามเปิดโจทย์เร็วเกินไป!")
				return
			end
			LastQuizTime[player.UserId] = currentTime
			
			print("📝 [SERVER DEBUG] กำลังสร้างโจทย์...")
			
			-- สร้างโจทย์
			local question, answer = generateMathProblem()
			
			-- เก็บข้อมูลโจทย์
			ActiveQuizzes[player.UserId] = {
				answer = answer,
				item = droppedItem,
				itemId = itemId.Value,
				timestamp = tick(),
				playerPosition = character.HumanoidRootPart.Position
			}
			
			print("✅ [SERVER DEBUG] สร้างโจทย์สำเร็จ!")
			print("   ผู้เล่น:", player.Name)
			print("   โจทย์:", question)
			print("   คำตอบ:", answer)
			print("   Item ID:", itemId.Value)
			print("   เวลา:", tick())
			
			-- แสดงว่ากำลังทำโจทย์
			label.Text = "⏳ กำลังทำโจทย์..."
			label.TextColor3 = Color3.fromRGB(255, 200, 0)
			hintLabel.Text = "รอคำตอบ..."
			
			-- ส่งโจทย์ไปให้ผู้เล่น
			ShowMathQuiz:FireClient(player, question, itemId.Value)
			print("📤 [SERVER DEBUG] ส่งโจทย์ไปยัง Client แล้ว!")
		end
	end)
	
	-- ลบของหลัง 90 วินาที
	Debris:AddItem(droppedItem, 90)
	
	return droppedItem
end

